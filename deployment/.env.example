LEARNING_POSTGRES_USER=learning
LEARNING_POSTGRES_PASSWORD=<generate-a-local-database-password>
LEARNING_POSTGRES_DB=vibemind_learning
LEARNHOUSE_AUTH_JWT_SECRET_KEY=<generate-at-least-32-random-characters>
LEARNHOUSE_COLLAB_INTERNAL_KEY=<generate-at-least-32-random-characters>
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=<choose-a-local-admin-password>
LEARNHOUSE_LOCAL_LEARNING_MODE=true
LEARNHOUSE_LOCAL_BOOTSTRAP_KEY=<generate-at-least-32-random-characters>
LEARNHOUSE_LEARNING_SERVICE_KEY=<generate-at-least-32-random-characters>
LEARNING_RETRIEVAL_SERVICE_KEY=<generate-at-least-32-random-characters>
LEARNING_EMBEDDING_URL=<OpenFang-authorized-embedding-service-url>
# Vector width of the model behind LEARNING_EMBEDDING_URL (Qdrant collection width).
LEARNING_EMBEDDING_DIMENSION=3072
LEARNING_OPENFANG_URL=<OpenFang-control-plane-url>
LEARNING_OPENFANG_API_KEY=<OpenFang-internal-api-key>
LEARNING_OPENFANG_MODEL=learning-course-factory
# Subscription lane (claude_code-backed OpenFang agent): inline + 600. Default: system + 60.
LEARNING_OPENFANG_PROMPT_TRANSPORT=inline
LEARNING_OPENFANG_TIMEOUT_SECONDS=600
PENECHO_LEARNING_TOKEN=<generate-at-least-32-random-characters>
LEARNING_EVALUATION_SERVICE_KEY=<generate-at-least-32-random-characters>
# Bearer key for VibeMind callers of the Course Factory HTTP adapter (/api/v1).
LEARNING_VIBEMIND_SERVICE_KEY=<generate-at-least-32-random-characters>

LEARNHOUSE_API_PORT=1338
LEARNHOUSE_WEB_PORT=13000
LEARNHOUSE_COLLAB_PORT=4000
LEARNING_API_PORT=8090
LEARNING_MCP_PORT=8091
QDRANT_HTTP_PORT=16333
PENECHO_PORT=3888

# Provider execution remains under the OpenFang authority chain. Do not place
# an OpenAI key in this file or in compose.yml.
OPENFANG_MODEL_PROVIDER=openai
